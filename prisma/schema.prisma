generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  googleId      String         @unique // Google's stable account id ("sub")
  email         String         @unique
  name          String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  generations   Generation[]
  courses       Course[]
}

// One row per issued refresh token. Only the SHA-256 hash is stored, so a
// database leak doesn't hand out usable sessions. `familyId` groups every
// token that descends from one login, so a reused token can revoke the chain.
model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// Every prompt a user submits, accepted or not: usage tracking, cost, abuse.
model Generation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt           String
  kind             String   @default("COURSE") // COURSE | LESSON
  status           String // ACCEPTED | REJECTED | FAILED
  reason           String? // OFF_TOPIC | UNCLEAR | BLOCKED, or the error for FAILED
  topic            String?
  courseId         String? // the course this attempt produced, if any
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

// A generated learning path, saved so the user can come back to it.
// `id` is set by the app (it is the id the course had when it was generated).
model Course {
  id          String       @id
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String
  title       String
  summary     String
  level       String
  duration    String
  steps       Json
  stepCount   Int
  lessons     Lesson[]
  completed   Int          @default(0) // steps finished, counted from the top
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]

  @@index([userId, updatedAt])
}

// The written lesson for one step, generated the first time it's opened and
// reused after that (so each lesson is only paid for once).
model Lesson {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stepId    String
  content   Json
  createdAt DateTime @default(now())

  @@unique([courseId, stepId])
}
